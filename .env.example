# ——— Database (PostgreSQL / Supabase) ———
# Runtime connection — use the pooled PgBouncer URL (transaction mode, port 6543)
# so serverless functions don't exhaust connections:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=""
# Schema pushes / migrations — session-mode connection (port 5432):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=""

# ——— Auth ———
# Secret for signing admin session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Password assigned to the seeded admin account (admin@goldenrule.local)
SEED_ADMIN_PASSWORD="GoldenRule2026!"

# ——— Public site URL (canonical/OG/sitemap) ———
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ——— AI assistant (optional) ———
# Anthropic API key. When unset the chatbot falls back to built-in guided answers.
AI_API_KEY=""

# ——— SMS provider (optional) ———
# When unset, outbound SMS (missed-call text-back, review requests) is mocked
# and logged to the Messages table instead of being sent.
SMS_API_KEY=""

# ——— Email provider (optional) ———
EMAIL_API_KEY=""

# ——— Maps (optional) ———
MAPS_API_KEY=""

# ——— Analytics (optional, e.g. GTM container) ———
ANALYTICS_ID=""

# ——— Review platform (optional) ———
REVIEW_API_KEY=""
